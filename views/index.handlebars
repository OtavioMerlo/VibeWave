<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VibeWave - A Revolução Musical da MS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #8a2be2;
            --secondary: #ba55d3;
            --dark: #121212;
            --light: #f8f9fa;
            --accent: #ff00ff;
            --text: #e0e0e0;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: var(--dark);
            color: var(--text);
            overflow-x: hidden;
        }
        
        /* Animations */
        @keyframes gradientFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        
        @keyframes neonGlow {
            0% { text-shadow: 0 0 5px var(--primary), 0 0 10px var(--primary); }
            50% { text-shadow: 0 0 20px var(--primary), 0 0 30px var(--accent); }
            100% { text-shadow: 0 0 5px var(--primary), 0 0 10px var(--primary); }
        }
        
        /* Header */
        header {
            background: linear-gradient(135deg, rgba(0,0,0,0.9) 0%, rgba(18,18,18,0.7) 100%);
            backdrop-filter: blur(10px);
            padding: 20px 5%;
            position: fixed;
            width: 100%;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            animation: neonGlow 3s infinite;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .logo i {
            font-size: 2rem;
            color: var(--primary);
        }
        
        .logo h1 {
            font-size: 1.8rem;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-weight: 700;
        }
        
        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }
        
        nav a {
            color: var(--text);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
        }
        
        nav a:hover {
            color: var(--primary);
        }
        
        nav a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            bottom: -5px;
            left: 0;
            transition: width 0.3s ease;
        }
        
        nav a:hover::after {
            width: 100%;
        }
        
        .cta-button {
            background: linear-gradient(to right, var(--primary), var(--secondary));
            color: var(--dark);
            border: none;
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px var(--primary);
        }
        
        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px var(--primary);
        }
        
        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            padding: 0 10%;
            position: relative;
            overflow: hidden;
        }
        
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--dark) 0%, rgba(0,0,0,0.7) 100%);
            z-index: -1;
        }
        
        .hero-content {
            width: 50%;
            z-index: 2;
        }
        
        .hero h2 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            background: linear-gradient(to right, var(--primary), var(--secondary), var(--accent));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            line-height: 1.2;
        }
        
        .hero p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            line-height: 1.6;
            opacity: 0.9;
        }
        
        .hero-buttons {
            display: flex;
            gap: 20px;
        }
        
        .secondary-button {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .secondary-button:hover {
            background: rgba(0, 242, 254, 0.1);
            transform: translateY(-3px);
        }
        
        .hero-image {
            position: absolute;
            right: 10%;
            width: 40%;
            animation: float 6s ease-in-out infinite;
        }
        
        .hero-image img {
            width: 100%;
            filter: drop-shadow(0 0 20px rgba(0, 242, 254, 0.5));
        }
        
        /* Features Section */
        .features {
            padding: 100px 10%;
            background: linear-gradient(to bottom, var(--dark) 0%, #0a0a0a 100%);
            position: relative;
        }
        
        .features::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;base64,');
            opacity: 0.3;
            z-index: 0;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 60px;
            position: relative;
            z-index: 1;
        }
        
        .section-title h3 {
            font-size: 2.5rem;
            margin-bottom: 15px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .section-title p {
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
            opacity: 0.8;
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            position: relative;
            z-index: 1;
        }
        
        .feature-card {
            background: rgba(30, 30, 30, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 30px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0, 242, 254, 0.2);
            border-color: rgba(0, 242, 254, 0.3);
        }
        
        .feature-icon {
            font-size: 2.5rem;
            margin-bottom: 20px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .feature-card h4 {
            font-size: 1.5rem;
            margin-bottom: 15px;
        }
        
        .feature-card p {
            opacity: 0.8;
            line-height: 1.6;
        }
        
        /* Pricing Section */
        .pricing {
            padding: 100px 10%;
            background: linear-gradient(to bottom, #0a0a0a 0%, var(--dark) 100%);
        }
        
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }
        
        .pricing-card {
            background: rgba(30, 30, 30, 0.7);
            border-radius: 15px;
            padding: 40px 30px;
            text-align: center;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }
        
        .pricing-card.popular {
            border: 1px solid var(--primary);
            box-shadow: 0 0 30px var(--primary);
            transform: scale(1.05);
        }
        
        .popular-badge {
            position: absolute;
            top: 0;
            right: 30px;
            background: var(--primary);
            color: var(--dark);
            padding: 5px 15px;
            border-bottom-left-radius: 5px;
            border-bottom-right-radius: 5px;
            font-weight: 600;
            font-size: 0.8rem;
        }
        
        .pricing-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px var(--primary);
        }
        
        .pricing-card h4 {
            font-size: 1.8rem;
            margin-bottom: 20px;
        }
        
        .price {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 20px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .price span {
            font-size: 1rem;
            opacity: 0.7;
        }
        
        .pricing-features {
            list-style: none;
            margin-bottom: 30px;
        }
        
        .pricing-features li {
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        /* About MS Section */
        .about-ms {
            padding: 100px 10%;
            background: linear-gradient(135deg, rgba(0,0,0,0.9) 0%, var(--dark) 100%);
            text-align: center;
        }
        
        .about-ms h3 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .about-ms p {
            max-width: 800px;
            margin: 0 auto 30px;
            font-size: 1.1rem;
            line-height: 1.6;
            opacity: 0.9;
        }
        
        .ms-logo {
            width: 150px;
            margin: 0 auto 30px;
            animation: pulse 2s infinite;
        }
        
        /* Footer */
        footer {
            background: #000;
            padding: 50px 10% 30px;
            position: relative;
        }
        
        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }
        
        .footer-column h5 {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: var(--primary);
        }
        
        .footer-column ul {
            list-style: none;
        }
        
        .footer-column li {
            margin-bottom: 10px;
        }
        
        .footer-column a {
            color: var(--text);
            text-decoration: none;
            opacity: 0.7;
            transition: all 0.3s ease;
        }

        .logop {
            font-size: 300px;
            color: var(--primary);
            
        }

        .logo i {
            background-color: linear-gradient(to right, var(--primary),  var(--accent));
        }
        
        .footer-column a:hover {
            opacity: 1;
            color: var(--primary);
        }
        
        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }
        
        .social-links a {
            color: var(--text);
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }
        
        .social-links a:hover {
            color: var(--primary);
            transform: translateY(-3px);
        }
        
        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            opacity: 0.7;
            font-size: 0.9rem;
        }
        
        /* Floating Elements */
        .floating-element {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0,242,254,0.3) 0%, rgba(0,242,254,0) 70%);
            z-index: -1;
        }
        
        .floating-element:nth-child(1) {
            width: 300px;
            height: 300px;
            top: 10%;
            left: 5%;
            animation: float 8s ease-in-out infinite;
        }
        
        .floating-element:nth-child(2) {
            width: 200px;
            height: 200px;
            bottom: 15%;
            right: 10%;
            animation: float 6s ease-in-out infinite reverse;
        }
        
        .floating-element:nth-child(3) {
            width: 150px;
            height: 150px;
            top: 40%;
            right: 20%;
            animation: float 5s ease-in-out infinite 2s;
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .hero-content {
                width: 100%;
                text-align: center;
            }
            
            .hero-image {
                display: none;
            }
            
            .hero-buttons {
                justify-content: center;
            }
        }
        
        @media (max-width: 768px) {
            nav ul {
                display: none;
            }
            
            .hero h2 {
                font-size: 2.5rem;
            }
            
            .section-title h3 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <!-- Floating Background Elements -->
    <div class="floating-element"></div>
    <div class="floating-element"></div>
    <div class="floating-element"></div>
    
    <!-- Header -->
    <header>
        <div class="logo">
            <i class="fas fa-wave-square"></i>
            <h1>VibeWave</h1>
        </div>
        <nav>
            <ul>
                <li><a href="#">Premium</a></li>
                <li><a href="#">Suporte</a></li>
                <li><a href="#">Baixar</a></li>
                <li><a href="#">Cadastre-se</a></li>
            </ul>
        </nav>
        <a href="/usuario/login"><button class="cta-button">Entrar</button></a>
    </header>
    
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h2>A Revolução na Experiência Musical</h2>
            <p>Desenvolvido pela MS Technology, o VibeWave traz a próxima geração de streaming de música com tecnologia de ponta, qualidade de áudio excepcional e recomendações inteligentes.</p>
            <div class="hero-buttons">
                <button class="cta-button">EXPERIMENTE GRÁTIS</button>
                <button class="secondary-button">VER PLANOS</button>
            </div>
        </div>
        <div class="hero-image">
            <i class="fas fa-wave-square logop"></i>
        </div>
    </section>
    
    <!-- Features Section -->
    <section class="features">
        <div class="section-title">
            <h3>Por que escolher o VibeWave?</h3>
            <p>Desenvolvido com a tecnologia de ponta da MS, oferecemos uma experiência musical incomparável</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h4>Velocidade Impressionante</h4>
                <p>Nossa tecnologia proprietária MS SpeedStream garante carregamento instantâneo de músicas, sem buffering, mesmo em conexões lentas.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-robot"></i>
                </div>
                <h4>AI Musical MS</h4>
                <p>Nosso algoritmo de inteligência artificial aprende seus gostos e cria playlists perfeitas para cada momento do seu dia.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-headphones-alt"></i>
                </div>
                <h4>Áudio Hi-Res</h4>
                <p>Experimente a música como nunca antes com nossa tecnologia MS HD Sound, oferecendo qualidade de estúdio em qualquer dispositivo.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h4>Multiplataforma</h4>
                <p>Acesse suas músicas em qualquer dispositivo com nossa tecnologia MS Sync, mantendo tudo perfeitamente sincronizado.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-music"></i>
                </div>
                <h4>Catálogo Exclusivo</h4>
                <p>Acesso a conteúdos exclusivos e lançamentos antes de qualquer outra plataforma, graças às parcerias estratégicas da MS.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h4>Estatísticas Detalhadas</h4>
                <p>Nosso dashboard MS Insights mostra seus hábitos musicais com análises profundas e visualizações interativas.</p>
            </div>
        </div>
    </section>
    
    <!-- Pricing Section -->
    <section class="pricing">
        <div class="section-title">
            <h3>Escolha seu plano VibeWave</h3>
            <p>Desfrute da melhor experiência musical com a tecnologia MS por um preço que cabe no seu bolso</p>
        </div>
        <div class="pricing-grid">
            <div class="pricing-card">
                <h4>Individual</h4>
                <div class="price">R$19,90<span>/mês</span></div>
                <ul class="pricing-features">
                    <li>1 conta premium</li>
                    <li>Cancelamento a qualquer momento</li>
                    <li>Qualidade de áudio Hi-Res</li>
                    <li>Offline Mode</li>
                    <li>Suporte prioritário</li>
                </ul>
                <button class="cta-button">ASSINE AGORA</button>
            </div>
            <div class="pricing-card popular">
                <div class="popular-badge">MAIS POPULAR</div>
                <h4>Duo</h4>
                <div class="price">R$24,90<span>/mês</span></div>
                <ul class="pricing-features">
                    <li>2 contas premium</li>
                    <li>Playlists compartilhadas</li>
                    <li>Tecnologia MS DuoSync</li>
                    <li>Offline Mode</li>
                    <li>Suporte VIP</li>
                </ul>
                <button class="cta-button">ASSINE AGORA</button>
            </div>
            <div class="pricing-card">
                <h4>Família</h4>
                <div class="price">R$34,90<span>/mês</span></div>
                <ul class="pricing-features">
                    <li>Até 6 contas premium</li>
                    <li>Controle parental MS</li>
                    <li>Mix Familiar MS</li>
                    <li>Offline Mode</li>
                    <li>Suporte 24/7</li>
                </ul>
                <button class="cta-button">ASSINE AGORA</button>
            </div>
        </div>
    </section>
    
    <!-- About MS Section -->
    <section class="about-ms">
        <div class="ms-logo">
            <img src="https://via.placeholder.com/150x150/121212/ffffff?text=MS" alt="MS Technology Logo">
        </div>
        <h3>Tecnologia MS por trás do VibeWave</h3>
        <p>A MS Technology é líder global em soluções digitais inovadoras. Com mais de 15 anos de experiência, desenvolvemos o VibeWave para revolucionar a forma como você experimenta música, combinando nosso expertise em cloud computing, inteligência artificial e processamento de áudio de última geração.</p>
        <p>O VibeWave representa o compromisso da MS em criar produtos que unem tecnologia avançada e experiências humanas excepcionais.</p>
        <button class="secondary-button">CONHEÇA A MS</button>
    </section>
    
    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-column">
                <h5>VibeWave</h5>
                <ul>
                    <li><a href="#">Sobre</a></li>
                    <li><a href="#">Empregos</a></li>
                    <li><a href="#">For the Record</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Comunidades</h5>
                <ul>
                    <li><a href="#">Para Artistas</a></li>
                    <li><a href="#">Desenvolvedores</a></li>
                    <li><a href="#">Publicidade</a></li>
                    <li><a href="#">Investidores</a></li>
                    <li><a href="#">Fornecedores</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Links úteis</h5>
                <ul>
                    <li><a href="#">Suporte</a></li>
                    <li><a href="#">Player da Web</a></li>
                    <li><a href="#">Aplicativo móvel grátis</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h5>Redes sociais</h5>
                <div class="social-links">
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>
        <div class="copyright">
            <p>&copy; 2023 MS Technology. Todos os direitos reservados.</p>
        </div>
    </footer>
    
    <script>
        // Simple animation triggers
        document.addEventListener('DOMContentLoaded', function() {
            const featureCards = document.querySelectorAll('.feature-card');
            
            featureCards.forEach((card, index) => {
                // Add delay to each card animation
                card.style.transitionDelay = `${index * 0.1}s`;
            });
            
            // Add scroll animation effects
            window.addEventListener('scroll', function() {
                const scrollPosition = window.scrollY;
                const heroContent = document.querySelector('.hero-content');
                
                if (heroContent) {
                    heroContent.style.transform = `translateY(${scrollPosition * 0.2}px)`;
                }
            });
        });
    </script>
</body>
</html>