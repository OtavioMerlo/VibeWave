<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Buscar</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="search"}}

        <main class="main-content">
            <header class="page-header">
                <h1>Buscar</h1>
                <div class="theme-toggle" role="button" aria-label="Alternar tema"><i class="fas fa-moon"></i></div>
            </header>

            <form class="search-bar" action="/search" method="get" role="search">
                <i class="fas fa-search"></i>
                <input type="search" name="q" value="{{termo}}" placeholder="O que você quer ouvir?"
                       aria-label="Buscar músicas e artistas" autofocus>
                <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
            </form>

            {{#if termo}}
            <section class="search-results">
                <h2>Resultados para <strong>"{{termo}}"</strong></h2>

                {{#if musicas.length}}
                <h3>Músicas ({{musicas.length}})</h3>
                <div class="track-list" data-fila>
                    {{#each musicas}}
                        {{> track-item this}}
                    {{/each}}
                </div>
                {{/if}}

                {{#if artistas.length}}
                <h3>Artistas ({{artistas.length}})</h3>
                <div class="artists-grid">
                    {{#each artistas}}
                    <div class="artist-card">
                        <div class="artist-avatar">
                            <img src="{{#if this.foto}}/uploads/artistas/{{this.foto}}{{else}}/img/default.svg{{/if}}" alt="{{this.nome}}" loading="lazy"
                                 onerror="this.onerror=null;this.src='/img/default.svg'">
                        </div>
                        <h3>{{this.nome}}</h3>
                        <p>{{this.genero_musical}}</p>
                        <a class="track-btn" href="/search?q={{#if this.nome}}{{this.nome}}{{/if}}" title="Ver músicas de {{this.nome}}" aria-label="Ver músicas de {{this.nome}}">
                            <i class="fas fa-music"></i>
                        </a>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#unless musicas.length}}
                    {{#unless artistas.length}}
                    <p class="empty-state">Nada encontrado para "{{termo}}". Tente outro termo.</p>
                    {{/unless}}
                {{/unless}}
            </section>
            {{else}}
            <section class="categorias">
                <a class="card grad-1" href="/search?q=Música"><h4>Música</h4><i class="fas fa-music"></i></a>
                <a class="card grad-2" href="/search?q=Eventos"><h4>Eventos ao vivo</h4><i class="fas fa-microphone-lines"></i></a>
                <a class="card grad-3" href="/search?q=Feito para você"><h4>Feito para você</h4><i class="fas fa-wand-magic-sparkles"></i></a>
                <a class="card grad-4" href="/search?q=Lançamentos"><h4>Lançamentos</h4><i class="fas fa-rocket"></i></a>
                <a class="card grad-5" href="/search?q=Brasil"><h4>Brasil</h4><i class="fas fa-earth-americas"></i></a>
                <a class="card grad-6" href="/search?q=Sertanejo"><h4>Sertanejo</h4><i class="fas fa-guitar"></i></a>
                <a class="card grad-1" href="/search?q=Funk"><h4>Funk</h4><i class="fas fa-drum"></i></a>
                <a class="card grad-2" href="/search?q=Samba"><h4>Samba e pagode</h4><i class="fas fa-drum-steelpan"></i></a>
                <a class="card grad-3" href="/search?q=Podcast"><h4>Podcasts</h4><i class="fas fa-podcast"></i></a>
                <a class="card grad-4" href="/search?q=Hip Hop"><h4>Hip Hop</h4><i class="fas fa-headphones"></i></a>
                <a class="card grad-5" href="/search?q=Rap"><h4>Rap</h4><i class="fas fa-microphone"></i></a>
                <a class="card grad-6" href="/search?q=MPB"><h4>MPB</h4><i class="fas fa-compact-disc"></i></a>
                <a class="card grad-1" href="/search?q=Rock"><h4>Rock</h4><i class="fas fa-guitar"></i></a>
                <a class="card grad-2" href="/search?q=Internacional"><h4>Internacional</h4><i class="fas fa-globe"></i></a>
            </section>
            {{/if}}
        </main>

        {{> player-footer}}
    </div>

    <script src="/js/player-core.js"></script>
    <script src="/js/vibewave.js"></script>
</body>
</html>
