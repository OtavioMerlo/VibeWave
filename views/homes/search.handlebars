<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Buscar</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
    <style>
        .search-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-pill);
            padding: 12px 20px;
            margin-bottom: 36px;
            transition: var(--transition);
        }
        .search-bar:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
        }
        .search-bar i { color: var(--text-dim); }
        .search-bar input {
            border: none;
            background: transparent;
            padding: 0;
            font-size: 1rem;
        }
        .search-bar input:focus { box-shadow: none; }

        .categorias {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 18px;
        }
        .categorias .card {
            position: relative;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
            min-height: 130px;
            overflow: hidden;
            cursor: pointer;
            transition: var(--transition);
        }
        .categorias .card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
        .categorias .card h4 { font-size: 1.05rem; font-weight: 600; position: relative; z-index: 2; }
        .categorias .card i {
            position: absolute;
            right: -8px;
            bottom: -12px;
            font-size: 4.5rem;
            opacity: 0.25;
            transform: rotate(-18deg);
        }
        .grad-1 { background: linear-gradient(135deg, #8b5cf6, #6366f1); }
        .grad-2 { background: linear-gradient(135deg, #ec4899, #8b5cf6); }
        .grad-3 { background: linear-gradient(135deg, #06b6d4, #3b82f6); }
        .grad-4 { background: linear-gradient(135deg, #f59e0b, #ef4444); }
        .grad-5 { background: linear-gradient(135deg, #10b981, #06b6d4); }
        .grad-6 { background: linear-gradient(135deg, #ef4444, #f97316); }
    </style>
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="search"}}

        <main class="main-content">
            <header class="page-header">
                <h1>Buscar</h1>
                <div class="theme-toggle" role="button" aria-label="Alternar tema"><i class="fas fa-moon"></i></div>
            </header>

            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="search" placeholder="O que você quer ouvir?" aria-label="Buscar">
            </div>

            <section class="categorias">
                <div class="card grad-1"><h4>Música</h4><i class="fas fa-music"></i></div>
                <div class="card grad-2"><h4>Eventos ao vivo</h4><i class="fas fa-microphone-lines"></i></div>
                <div class="card grad-3"><h4>Feito para você</h4><i class="fas fa-wand-magic-sparkles"></i></div>
                <div class="card grad-4"><h4>Lançamentos</h4><i class="fas fa-rocket"></i></div>
                <div class="card grad-5"><h4>Brasil</h4><i class="fas fa-earth-americas"></i></div>
                <div class="card grad-6"><h4>Sertanejo</h4><i class="fas fa-guitar"></i></div>
                <div class="card grad-1"><h4>Funk</h4><i class="fas fa-drum"></i></div>
                <div class="card grad-2"><h4>Samba e pagode</h4><i class="fas fa-drum-steelpan"></i></div>
                <div class="card grad-3"><h4>Podcasts</h4><i class="fas fa-podcast"></i></div>
                <div class="card grad-4"><h4>Hip Hop</h4><i class="fas fa-headphones"></i></div>
                <div class="card grad-5"><h4>Rap</h4><i class="fas fa-microphone"></i></div>
                <div class="card grad-6"><h4>MPB</h4><i class="fas fa-compact-disc"></i></div>
                <div class="card grad-1"><h4>Rock</h4><i class="fas fa-guitar"></i></div>
                <div class="card grad-2"><h4>Internacional</h4><i class="fas fa-globe"></i></div>
            </section>
        </main>

        {{> player-footer}}
    </div>

    <script src="/js/vibewave.js"></script>
</body>
</html>
