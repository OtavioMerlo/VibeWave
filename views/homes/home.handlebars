<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Descobrir</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="home"}}

        <main class="main-content">
            <header class="page-header">
                <div>
                    <h1>Descobrir</h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                        Bom te ver, {{#if user}}{{user.name}}{{else}}ouvinte{{/if}}!
                    </p>
                </div>
                <div class="theme-toggle" role="button" aria-label="Alternar tema" tabindex="0">
                    <i class="fas fa-moon"></i>
                </div>
            </header>

            <section class="featured-playlists" data-fila>
                <h2>Em destaque</h2>
                <div class="playlist-grid">
                    {{#each musicas}}
                        {{> track-card this}}
                    {{else}}
                        <p class="empty-state">Nenhuma música cadastrada ainda. <a href="/admin/musicas/nova">Cadastre a primeira</a>.</p>
                    {{/each}}
                </div>
            </section>

            <section class="recently-played" data-fila>
                <h2>Tocadas recentemente</h2>
                <div class="track-list">
                    {{#each musicas}}
                        {{> track-item this}}
                    {{else}}
                        <p class="empty-state">Seu histórico aparecerá aqui.</p>
                    {{/each}}
                </div>
            </section>
        </main>

        {{> player-footer}}
    </div>

    <script src="/js/player-core.js"></script>
    <script src="/js/vibewave.js"></script>
    <script src="/js/spa.js"></script>
</body>
</html>