<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Descobrir</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="home"}}

        <main class="main-content">
            <header class="page-header">
                <div>
                    <h1>Descobrir</h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">
                        Bom te ver, {{#if user}}{{user.name}}{{else}}ouvinte{{/if}}!
                    </p>
                </div>
                <div class="theme-toggle" role="button" aria-label="Alternar tema">
                    <i class="fas fa-moon"></i>
                </div>
            </header>

            <section class="featured-playlists">
                <h2>Em destaque</h2>
                <div class="playlist-grid">
                    {{#each musicas}}
                    <a href="/player/{{this.id}}" class="playlist-card">
                        <div class="playlist-cover">
                            {{#if this.capa}}
                                <img src="/uploads/capamusica/{{this.capa}}" alt="{{this.titulo}}">
                            {{else}}
                                <div class="cover-placeholder"><i class="fas fa-music"></i></div>
                            {{/if}}
                            <div class="play-button"><i class="fas fa-play"></i></div>
                        </div>
                        <h3>{{this.titulo}}</h3>
                        <p>{{this.artista.nome}}</p>
                    </a>
                    {{else}}
                    <p style="color: var(--text-muted);">Nenhuma música cadastrada ainda.</p>
                    {{/each}}
                </div>
            </section>

            <section class="recently-played">
                <h2>Tocadas recentemente</h2>
                <div class="track-list">
                    {{#each musicas}}
                    <div class="track-item" onclick="location.href='/player/{{this.id}}'">
                        <div class="track-number">{{inc @index}}</div>
                        <div class="track-cover">
                            {{#if this.capa}}
                                <img src="/uploads/capamusica/{{this.capa}}" alt="{{this.titulo}}">
                            {{else}}
                                <div class="cover-placeholder"><i class="fas fa-music"></i></div>
                            {{/if}}
                        </div>
                        <div class="track-info">
                            <h3>{{this.titulo}}</h3>
                            <p>{{this.artista.nome}} · {{this.genero}}</p>
                        </div>
                        <div class="track-duration">{{formatDuracao this.duracao}}</div>
                    </div>
                    {{else}}
                    <p style="color: var(--text-muted);">Seu histórico aparecerá aqui.</p>
                    {{/each}}
                </div>
            </section>
        </main>

        {{> player-footer musicaAtual=musicas.[0]}}
    </div>

    <script src="/js/vibewave.js"></script>
</body>
</html>
