<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Sua Biblioteca</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
    <style>
        .library-actions { display: flex; align-items: center; gap: 14px; }
        .artists-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 20px;
        }
        .artist-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px;
            text-align: center;
            transition: var(--transition);
            cursor: pointer;
        }
        .artist-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); border-color: var(--primary); }
        .artist-avatar {
            width: 110px;
            height: 110px;
            margin: 0 auto 14px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid var(--primary);
            background: var(--surface-3);
        }
        .artist-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .artist-card h3 { font-size: 0.98rem; }
        .artist-card p { color: var(--text-muted); font-size: 0.82rem; }
    </style>
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="library"}}

        <main class="main-content">
            <header class="page-header">
                <h1>Sua Biblioteca</h1>
                <div class="library-actions">
                    <button onclick="abrirModal('modal')" class="btn btn-primary"><i class="fas fa-plus"></i> Criar playlist</button>
                    <div class="theme-toggle" role="button" aria-label="Alternar tema"><i class="fas fa-moon"></i></div>
                </div>
            </header>

            <div id="modal" class="modal">
                <div class="modal-content">
                    <button class="fechar" onclick="fecharModal('modal')">&times;</button>
                    <h2>Criar playlist</h2>
                    <div class="field">
                        <label>Nome da playlist</label>
                        <input type="text" placeholder="Digite um nome legal...">
                    </div>
                    <div class="field">
                        <label>Descrição</label>
                        <input type="text" placeholder="Descreva sua playlist...">
                    </div>
                    <button class="btn btn-primary" onclick="fecharModal('modal')">Confirmar</button>
                </div>
            </div>

            <section class="library-tabs">
                <div class="tabs">
                    <button class="tab active" data-tab="musicas">Músicas</button>
                    <button class="tab" data-tab="artistas">Artistas</button>
                </div>
            </section>

            <section class="library-content">
                <div class="tab-content active" id="musicas">
                    <div class="playlist-grid">
                        {{#each musicas}}
                        <a href="/player/{{this.id}}" class="playlist-card">
                            <div class="playlist-cover">
                                {{#if this.capa}}
                                    <img src="/uploads/capamusica/{{this.capa}}" alt="{{this.titulo}}">
                                {{else}}
                                    <div class="cover-placeholder"><i class="fas fa-music"></i></div>
                                {{/if}}
                                <div class="play-button"><i class="fas fa-play"></i></div>
                            </div>
                            <h3>{{this.titulo}}</h3>
                            <p>{{this.artista.nome}}</p>
                        </a>
                        {{else}}
                        <p style="color: var(--text-muted);">Nenhuma música na sua biblioteca ainda.</p>
                        {{/each}}
                    </div>
                </div>

                <div class="tab-content" id="artistas">
                    <div class="artists-grid">
                        {{#each artistas}}
                        <div class="artist-card">
                            <div class="artist-avatar">
                                {{#if this.foto}}
                                    <img src="/uploads/artistas/{{this.foto}}" alt="{{this.nome}}">
                                {{else}}
                                    <div class="cover-placeholder"><i class="fas fa-user"></i></div>
                                {{/if}}
                            </div>
                            <h3>{{this.nome}}</h3>
                            <p>{{this.genero_musical}}</p>
                        </div>
                        {{else}}
                        <p style="color: var(--text-muted);">Nenhum artista cadastrado ainda.</p>
                        {{/each}}
                    </div>
                </div>
            </section>
        </main>

        {{> player-footer}}
    </div>

    <script src="/js/vibewave.js"></script>
</body>
</html>
