<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Perfil</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="perfil"}}

        <main class="main-content">
            <header class="page-header">
                <h1>Seu perfil</h1>
                <div class="theme-toggle" role="button" aria-label="Alternar tema"><i class="fas fa-moon"></i></div>
            </header>

            <section class="profile-header">
                <img src="{{#if user.foto}}/uploads/FotoUser/{{user.foto}}{{else}}/img/default.svg{{/if}}" alt="{{user.name}}" class="foto-perfil" loading="lazy"
                     onerror="this.onerror=null;this.src='/img/default.svg'">
                <div class="info-usuario">
                    <h1>{{user.name}}</h1>
                    <p><i class="fas fa-envelope"></i> {{user.email}}</p>
                    <div style="margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap;">
                        <button class="btn btn-primary" onclick="abrirModal('editar')"><i class="fas fa-pen"></i> Editar perfil</button>
                        <a href="/usuario/logout" class="btn btn-secondary"><i class="fas fa-right-from-bracket"></i> Sair</a>
                    </div>
                </div>
            </section>

            <section class="library-tabs">
                <div class="tabs">
                    <button class="tab active" data-tab="publicadas">Playlists publicadas</button>
                </div>
            </section>

            <section class="library-content">
                <div class="tab-content active" id="publicadas">
                    <div class="playlist-grid">
                        <a href="/playlist" class="playlist-card">
                            <div class="playlist-cover"><div class="cover-placeholder"><i class="fas fa-heart"></i></div></div>
                            <h3>Favoritas</h3>
                            <p>Sua coleção</p>
                        </a>
                        <a href="/recentemente" class="playlist-card">
                            <div class="playlist-cover"><div class="cover-placeholder"><i class="fas fa-clock"></i></div></div>
                            <h3>Recentes</h3>
                            <p>Últimas escutadas</p>
                        </a>
                        <a href="/treino" class="playlist-card">
                            <div class="playlist-cover"><div class="cover-placeholder"><i class="fas fa-dumbbell"></i></div></div>
                            <h3>Treino</h3>
                            <p>Workout mix</p>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <div class="modal" id="editar">
            <div class="modal-content">
                <button class="fechar" onclick="fecharModal('editar')">&times;</button>
                <h2>Detalhes do perfil</h2>
                <img src="{{#if user.foto}}/uploads/FotoUser/{{user.foto}}{{else}}/img/default.svg{{/if}}" alt="foto" class="foto" id="fotoPreview" style="width: 110px; height: 110px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary);"
                     onerror="this.onerror=null;this.src='/img/default.svg'">
                <div class="field">
                    <label>Nome</label>
                    <input type="text" value="{{user.name}}">
                </div>
                <input type="file" id="inputFoto" accept="image/*" style="display: none;" onchange="carregarImagem(event)">
                <button class="btn btn-secondary" type="button" onclick="document.getElementById('inputFoto').click()">
                    <i class="fas fa-camera"></i> Trocar foto
                </button>
                <button class="btn btn-primary" type="button" onclick="fecharModal('editar')">Salvar</button>
            </div>
        </div>

        {{> player-footer}}
    </div>

    <script src="/js/player-core.js"></script>
    <script src="/js/vibewave.js"></script>
</body>
</html>
