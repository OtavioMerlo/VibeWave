<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | {{musica.titulo}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="library"}}

        <main class="main-content player-main">
            <section class="player-section">
                <div class="album-art-container">
                    <div class="album-art">
                        {{#if musica.capa}}
                            <img src="/uploads/capamusica/{{musica.capa}}" alt="Capa de {{musica.titulo}}" id="album-art"
                                 onerror="this.onerror=null;this.src='/img/default.svg'">
                        {{else}}
                            <div class="cover-placeholder" id="album-art"><i class="fas fa-music" style="font-size:3rem;"></i></div>
                        {{/if}}
                        <div class="vinyl"></div>
                    </div>
                </div>

                <div class="player-info">
                    <span class="player-kicker">Tocando agora</span>
                    <h1 id="song-title" data-p-titulo>{{musica.titulo}}</h1>
                    <h2 id="song-artist" data-p-artista>{{#if musica.artista}}{{musica.artista.nome}}{{else}}Artista desconhecido{{/if}}</h2>

                    <div class="song-progress">
                        <div class="progress-container">
                            <span class="time-current" data-p-atual>0:00</span>
                            <div class="progress-bar" data-p-barra>
                                <div class="progress" data-p-progresso></div>
                            </div>
                            <span class="time-total" data-p-total>{{tempo}}</span>
                        </div>
                    </div>

                    <div class="player-buttons">
                        <button type="button" class="player-btn shuffle" data-p-shuffle aria-label="Aleatório"><i class="fas fa-shuffle"></i></button>
                        <button type="button" class="player-btn prev" data-p-prev aria-label="Anterior"><i class="fas fa-step-backward"></i></button>
                        <button type="button" class="player-btn play" data-p-play aria-label="Play/Pause"><i class="fas fa-play"></i></button>
                        <button type="button" class="player-btn next" data-p-next aria-label="Próxima"><i class="fas fa-step-forward"></i></button>
                        <button type="button" class="player-btn repeat" data-p-repeat aria-label="Repetir"><i class="fas fa-repeat"></i></button>
                    </div>

                    <div class="player-options">
                        <button type="button" class="option-btn volume-btn" data-p-mute aria-label="Silenciar"><i class="fas fa-volume-up"></i></button>
                        <input type="range" min="0" max="100" value="80" data-p-volume aria-label="Volume">
                        <span class="volume-valor" data-p-volume-valor>80%</span>
                        <button type="button" class="option-btn like" aria-label="Favoritar" disabled><i class="far fa-heart"></i></button>
                        <button type="button" class="option-btn share" aria-label="Compartilhar" disabled><i class="fas fa-share-alt"></i></button>
                    </div>

                    <button type="button" class="btn btn-primary btn-play-page" data-play-page
                            data-track-id="{{musica.id}}"
                            data-track-src="/uploads/musicas/{{musica.audio}}"
                            data-track-capa="{{#if musica.capa}}/uploads/capamusica/{{musica.capa}}{{else}}/img/default.svg{{/if}}"
                            data-track-titulo="{{musica.titulo}}"
                            data-track-artista="{{#if musica.artista}}{{musica.artista.nome}}{{else}}Artista desconhecido{{/if}}"
                            data-track-duracao="{{musica.duracao}}">
                        <i class="fas fa-play"></i> Tocar no player principal
                    </button>
                </div>
            </section>
        </main>

        {{> player-footer}}
    </div>

    <script src="/js/player-core.js"></script>
    <script src="/js/vibewave.js"></script>
    <script src="/js/spa.js"></script>
</body>
</html>