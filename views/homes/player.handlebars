<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | {{musica.titulo}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="app-container">
        {{> mobile-nav}}
        {{> sidebar active="player"}}

        <audio id="bgAudio" preload="metadata">
            <source src="/uploads/musicas/{{musica.audio}}" type="audio/mpeg">
        </audio>

        <main class="main-content player-main">
            <section class="player-section">
                <div class="album-art-container">
                    <div class="album-art">
                        {{#if musica.capa}}
                            <img src="/uploads/capamusica/{{musica.capa}}" alt="Capa de {{musica.titulo}}" id="album-art">
                        {{else}}
                            <div class="cover-placeholder" id="album-art"><i class="fas fa-music" style="font-size:3rem;"></i></div>
                        {{/if}}
                        <div class="vinyl"></div>
                    </div>
                    <canvas id="waveform"></canvas>
                </div>

                <div class="player-info">
                    <span style="color: var(--primary-light); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px;">Tocando agora</span>
                    <h1 id="song-title">{{musica.titulo}}</h1>
                    <h2 id="song-artist">{{musica.artista.nome}}</h2>

                    <div class="song-progress">
                        <div class="progress-container" id="progress-container">
                            <span class="time-current" id="current-time">0:00</span>
                            <div class="progress-bar">
                                <div class="progress" id="song-progress"></div>
                            </div>
                            <span class="time-total" id="duration">{{tempo}}</span>
                        </div>
                    </div>

                    <div class="player-buttons">
                        <button class="player-btn shuffle" aria-label="Aleatório"><i class="fas fa-random"></i></button>
                        <button class="player-btn prev" aria-label="Anterior"><i class="fas fa-step-backward"></i></button>
                        <button class="player-btn play" id="play-btn" aria-label="Play/Pause"><i class="fas fa-play"></i></button>
                        <button class="player-btn next" aria-label="Próxima"><i class="fas fa-step-forward"></i></button>
                        <button class="player-btn repeat" aria-label="Repetir"><i class="fas fa-redo"></i></button>
                    </div>

                    <div class="player-options">
                        <button class="option-btn like" aria-label="Favoritar"><i class="far fa-heart"></i></button>
                        <button class="option-btn add-to-playlist" aria-label="Adicionar"><i class="fas fa-plus"></i></button>
                        <button class="option-btn share" aria-label="Compartilhar"><i class="fas fa-share-alt"></i></button>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script src="/js/player.js"></script>
    <script src="/js/vibewave.js"></script>
</body>
</html>
