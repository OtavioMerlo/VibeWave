<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aguafina+Script&family=Arvo:ital,wght@0,400;0,700;1,400;1,700&family=Boldonse&family=Great+Vibes&family=League+Gothic:wdth@96.6&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <title>Vibewave | Mix de Treino</title>
</head>
<body>
    <div class="app-container player-view">
        <!-- Navegação Lateral -->
        <nav class="sidebar">
            <div class="logo">
                <span class="logo-icon">VW</span>
                <span class="logo-text">Vibewave</span>
            </div>
            <ul class="nav-links">
                <li class="active">
                    <a href="/home">
                        <i class="fas fa-home"></i>
                        <span>Início</span>
                    </a>
                </li>
                <li>
                    <a href="/search">
                        <i class="fas fa-search"></i>
                        <span>Buscar</span>
                    </a>
                </li>
                <li>
                    <a href="/lybrary">
                        <i class="fas fa-book"></i>
                        <span>Sua biblioteca</span>
                    </a>
                </li>
                <li>
                    <a href="/perfil">
                        <i class="fas fa-user"></i>
                        <span>Perfil</span>
                    </a>
                </li>
            </ul>
            <div class="playlists">
                <h3>Suas Playlists</h3>
                <ul>
                    <li><a href="playlist.html"  >Favoritas</a></li>
                    <li><a href="Recentemente.html">Reproduzidas Recentemente</a></li>
                    <li><a href="Treino.html">Mix de Treino</a></li>
                </ul>
            </div>
        </nav>

        <!-- Navegação Mobile -->
        <nav class="mobile-nav">
            <button class="hamburger">
                <i class="fas fa-bars"></i>
            </button>
            <div class="mobile-logo">VW</div>
            <button class="back-button" onclick="window.history.back()">
                <i class="fas fa-arrow-left"></i>
            </button>
        </nav>

        <!-- Conteúdo Principal -->
        <main class="main-content player-main">
            <section class="player-section">
                <h1 class="nome-play">Mix de Treino</h1>
                <br>
                <div class="album-art-container">
                    <div class="album-art">
                        <img src="assets/img/treino.jpg" alt="Capa do Álbum" id="album-art3">
                        <div class="vinyl"></div>
                    </div>
                    <canvas id="waveform"></canvas>
                </div>

                <div class="player-info">
                    <h1 id="song-title2">AUTOMOTIVO DA SEQUÊNCIA INTER-CELESTIAL 4.0 (slowed)</h1>
                    <h2 id="song-artist2">DJ TSK </h2>
                    <div class="song-progress">
                        <div class="progress-container">
                            <div class="progress-bar">
                                <div class="progress" id="song-progress"></div>
                            </div>
                            <div class="time-display">
                                <span id="current-time2">1:00</span>
                                <span id="duration2">3:47</span>
                            </div>
                        </div>
                    </div>
                    <div class="player-buttons">
                        <button class="player-btn shuffle">
                            <i class="fas fa-random"></i>
                        </button>
                        <button class="player-btn prev">
                            <i class="fas fa-step-backward"></i>
                        </button>
                        <button class="player-btn play" id="play-btn">
                            <i class="fas fa-play"></i>
                        </button>
                        <button class="player-btn next">
                            <i class="fas fa-step-forward"></i>
                        </button>
                        <button class="player-btn repeat">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                    <div class="player-options">
                        <button class="option-btn like">
                            <i class="far fa-heart"></i>
                        </button>
                        <button class="option-btn add-to-playlist">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button class="option-btn share">
                            <i class="fas fa-share-alt"></i>
                        </button>
                    </div>
                </div>

                <div class="queue-section">
                    <h3>Próximas na Fila</h3>
                    <div class="queue-list">
                        <div class="queue-item">
                            <div class="queue-cover">
                                <img src="assets/img/deixa.jpg" alt="Capa da Fila">
                            </div>
                            <div class="queue-info">
                                <h4>Deixa Alagar</h4>
                                <p>Turma do Pagode</p>
                            </div>
                            <div class="queue-duration">4:12</div>
                        </div>
                        <div class="queue-item">
                            <div class="queue-cover">
                                <img src="assets/img/evidencia.jpg" alt="Capa da Fila">
                            </div>
                            <div class="queue-info">
                                <h4>Evidencias</h4>
                                <p>Chitãozinho e Xororó</p>
                            </div>
                            <div class="queue-duration">3:58</div>
                        </div>
                        <div class="queue-item">
                            <div class="queue-cover">
                                <img src="assets/img/camisa10.jpg" alt="Capa da Fila">
                            </div>
                            <div class="queue-info">
                                <h4>Camisa 10</h4>
                                <p>Tiaguinho</p>
                            </div>
                            <div class="queue-duration">3:58</div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Rodapé do Player -->
        <footer class="player-footer">
            <div class="now-playing">
                <div class="now-playing-cover">
                    <img src="assets/img/internet.jpg" alt="Capa Tocando Agora">
                </div>
                <div class="now-playing-info">
                    <h3>A Internet é Toxica</h3>
                    <p>Mc Saci, Mc Pretchako, Dj LC, Dj João da Inestan</p>
                </div>
                <button class="like-btn">
                    <i class="far fa-heart"></i>
                </button>
            </div>
            <div class="player-controls">
                <div class="control-buttons">
                    <button class="control-btn shuffle">
                        <i class="fas fa-random"></i>
                    </button>
                    <button class="control-btn prev">
                        <i class="fas fa-step-backward"></i>
                    </button>
                    <button class="control-btn play">
                        <i class="fas fa-play"></i>
                    </button>
                    <button class="control-btn next">
                        <i class="fas fa-step-forward"></i>
                    </button>
                    <button class="control-btn repeat">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>
                <div class="progress-container">
                    <span class="time-current">0:00</span>
                    <div class="progress-bar">
                        <div class="progress"></div>
                    </div>
                    <span class="time-total">3:45</span>
                </div>
            </div>
            <div class="player-options">
                <button class="volume-btn">
                    <i class="fas fa-volume-up"></i>
                </button>
                <div class="volume-slider">
                    <input type="range" min="0" max="100" value="80">
                </div>
            </div>
        </footer>
    </div>

    <script src="js/player.js"></script>
</body>
</html>