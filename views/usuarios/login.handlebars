<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Entrar</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/vibewave.css">
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="logo">
                <span class="logo-icon"><i class="fas fa-wave-square"></i></span>
                <span class="logo-text">Vibewave</span>
            </div>
            <h1>Bem-vindo de volta</h1>
            <p class="subtitle">Entre ou crie sua conta para continuar</p>

            {{#each erros}}
                <div class="alert alert-danger">{{texto}}</div>
            {{/each}}
            {{#if error_msg}}
                <div class="alert alert-danger">{{error_msg}}</div>
            {{/if}}
            {{#if success_msg}}
                <div class="alert alert-success">{{success_msg}}</div>
            {{/if}}

            <div class="auth-tabs">
                <button type="button" class="active" data-auth="login">Entrar</button>
                <button type="button" data-auth="signup">Cadastrar</button>
            </div>

            <form class="auth-form active" id="login-form" action="/usuario/login" method="post">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <input type="hidden" name="redirect" value="{{redirect}}">
                <div class="field">
                    <label for="login-email">E-mail</label>
                    <div class="input-group">
                        <i class="fas fa-envelope"></i>
                        <input id="login-email" name="email" type="email" placeholder="seu@email.com" required>
                    </div>
                </div>
                <div class="field">
                    <label for="login-pass">Senha</label>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input id="login-pass" name="password" type="password" placeholder="Sua senha" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Entrar</button>
            </form>

            <form class="auth-form" id="signup-form" action="/usuario/registro" method="post">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <input type="hidden" name="redirect" value="{{redirect}}">
                <div class="field">
                    <label for="signup-name">Nome</label>
                    <div class="input-group">
                        <i class="fas fa-user"></i>
                        <input id="signup-name" name="nome" type="text" placeholder="Seu nome" required>
                    </div>
                </div>
                <div class="field">
                    <label for="signup-email">E-mail</label>
                    <div class="input-group">
                        <i class="fas fa-envelope"></i>
                        <input id="signup-email" name="email" type="email" placeholder="seu@email.com" required>
                    </div>
                </div>
                <div class="field">
                    <label for="signup-pass">Senha</label>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input id="signup-pass" name="senha" type="password" placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password" required>
                    </div>
                </div>
                <div class="field">
                    <label for="signup-pass2">Confirmar senha</label>
                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        <input id="signup-pass2" name="senha2" type="password" placeholder="Repita a senha" minlength="8" autocomplete="new-password" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Criar conta</button>
            </form>
        </div>
    </div>

    <script>
        const authButtons = document.querySelectorAll('[data-auth]');
        const loginForm = document.getElementById('login-form');
        const signupForm = document.getElementById('signup-form');

        authButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const target = button.getAttribute('data-auth');
                authButtons.forEach((b) => b.classList.remove('active'));
                button.classList.add('active');
                loginForm.classList.toggle('active', target === 'login');
                signupForm.classList.toggle('active', target === 'signup');
            });
        });
    </script>
</body>
</html>
