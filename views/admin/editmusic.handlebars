<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Editar Música</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="form-page">
        <div class="form-card">
            <h1><i class="fas fa-music" style="color:#a78bfa"></i> Editar música</h1>
            <p class="sub">{{musica.titulo}}</p>

            <div class="form-grid">
                <div class="field">
                    <label>Título</label>
                    <input type="text" value="{{musica.titulo}}" readonly>
                </div>
                <div class="field">
                    <label>Gênero</label>
                    <input type="text" value="{{musica.genero}}" readonly>
                </div>
                <div class="field">
                    <label>Duração</label>
                    <input type="text" value="{{formatDuracao musica.duracao}}" readonly>
                </div>
                <div class="field">
                    <label>Status</label>
                    <input type="text" value="{{musica.status}}" readonly>
                </div>
            </div>

            <div class="field">
                <label>Prévia do áudio</label>
                <audio controls style="width:100%">
                    <source src="/uploads/musicas/{{musica.audio}}">
                    Seu navegador não suporta o elemento de áudio.
                </audio>
            </div>

            <div class="field">
                <label for="lyrics">Letra</label>
                <textarea id="lyrics" readonly>{{musica.letra}}</textarea>
            </div>

            <form method="post" action="/admin/musica/edit/{{musica.id}}" enctype="multipart/form-data">
                <div class="field">
                    <label>Atualizar capa</label>
                    <div class="photo-row">
                        <img id="coverPreview"
                            src="{{#if musica.capa}}/uploads/capamusica/{{musica.capa}}{{else}}/img/default.svg{{/if}}"
                            class="photo-preview" alt="{{musica.titulo}}">
                        <input type="file" id="coverInput" name="file" accept="image/*">
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/admin" class="btn btn-ghost"><i class="fas fa-times"></i> Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar capa</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var input = document.getElementById('coverInput');
        var preview = document.getElementById('coverPreview');
        input.addEventListener('change', function () {
            var file = this.files && this.files[0];
            if (file) preview.src = URL.createObjectURL(file);
        });
    </script>
</body>
</html>
