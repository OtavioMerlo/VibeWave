<div class="page-top">
    <div>
        <h1>Painel de controle</h1>
        <p>Bem-vindo de volta{{#if user.name}}, {{user.name}}{{/if}}! Gerencie o catálogo do Vibewave.</p>
    </div>
    <div class="page-top-actions">
        <a href="/admin/musicas/nova" class="btn btn-primary"><i class="fas fa-plus"></i> Nova música</a>
        <a href="/admin/artistas/nova" class="btn btn-ghost"><i class="fas fa-user-plus"></i> Novo artista</a>
    </div>
</div>

<section class="stat-grid">
    <a href="/admin/musicas" class="stat-card stat-card--link">
        <div>
            <h4>Músicas</h4>
            <div class="value">{{totalMusicas}}</div>
            <small>{{musicasPendentes}} pendente(s)</small>
        </div>
        <div class="stat-icon"><i class="fas fa-music"></i></div>
    </a>
    <a href="/admin/artistas" class="stat-card stat-card--link">
        <div>
            <h4>Artistas</h4>
            <div class="value">{{totalArtistas}}</div>
            <small>{{artistasInativos}} inativo(s)</small>
        </div>
        <div class="stat-icon"><i class="fas fa-user"></i></div>
    </a>
    <a href="/admin/usuarios" class="stat-card stat-card--link">
        <div>
            <h4>Usuários</h4>
            <div class="value">{{totalUsuarios}}</div>
            <small>cadastrados</small>
        </div>
        <div class="stat-icon"><i class="fas fa-users"></i></div>
    </a>
    <a href="/admin/perfil" class="stat-card stat-card--link">
        <div>
            <h4>Meu acesso</h4>
            <div class="value" style="font-size:1.15rem;word-break:break-word">{{user.email}}</div>
            <small>trocar senha</small>
        </div>
        <div class="stat-icon"><i class="fas fa-user-shield"></i></div>
    </a>
</section>

<div class="grid-2">
    <section class="panel">
        <div class="panel-head">
            <h2><i class="fas fa-clock-rotate-left"></i> Últimas músicas</h2>
            <a href="/admin/musicas" class="btn btn-ghost btn-sm">Ver todas</a>
        </div>
        <div class="panel-body">
            <div class="mini-list">
                {{#each ultimasMusicas}}
                <div class="mini-item">
                    {{> capa capa=this.capa alt=this.titulo classe="mini-cover"}}
                    <div class="mini-info">
                        <strong>{{this.titulo}}</strong>
                        <small>{{#if this.artista}}{{this.artista.nome}}{{else}}Sem artista{{/if}} · {{formatDuracao this.duracao}}</small>
                    </div>
                    <span class="badge {{#eq this.status 'Ativa'}}badge-green{{/eq}}{{#eq this.status 'Pendente'}}badge-yellow{{/eq}}{{#eq this.status 'Inativa'}}badge-gray{{/eq}}">{{this.status}}</span>
                </div>
                {{else}}
                <p class="empty-row">Nenhuma música cadastrada.</p>
                {{/each}}
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2><i class="fas fa-user-plus"></i> Últimos artistas</h2>
            <a href="/admin/artistas" class="btn btn-ghost btn-sm">Ver todos</a>
        </div>
        <div class="panel-body">
            <div class="mini-list">
                {{#each ultimosArtistas}}
                <div class="mini-item">
                    <img class="mini-avatar" src="{{#if this.foto}}/uploads/artistas/{{this.foto}}{{else}}/img/default.svg{{/if}}" alt="{{this.nome}}" loading="lazy"
                         onerror="this.onerror=null;this.src='/img/default.svg'">
                    <div class="mini-info">
                        <strong>{{this.nome}}</strong>
                        <small>{{this.genero_musical}} · {{this.pais}}</small>
                    </div>
                    <span class="badge {{#eq this.status 'Ativo'}}badge-green{{/eq}}{{#eq this.status 'Inativo'}}badge-gray{{/eq}}{{#eq this.status 'Pausa'}}badge-yellow{{/eq}}">{{this.status}}</span>
                </div>
                {{else}}
                <p class="empty-row">Nenhum artista cadastrado.</p>
                {{/each}}
            </div>
        </div>
    </section>
</div>