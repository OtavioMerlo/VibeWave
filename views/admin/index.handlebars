<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo - Música</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #6c5bf1;
            --secondary-color: #a29bfe;
            --dark-color: #2d3436;
            --light-color: #f5f6fa;
        }
        
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 0;
        }
        
        .sidebar-header {
            padding: 20px;
            background-color: rgba(0, 0, 0, 0.1);
        }
        
        .sidebar-menu {
            padding: 20px 0;
        }
        
        .sidebar-menu a {
            color: white;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .sidebar-menu a:hover {
            background-color: rgba(255, 255, 255, 0.1);
            padding-left: 25px;
        }
        
        .sidebar-menu a.active {
            background-color: rgba(255, 255, 255, 0.2);
            border-left: 4px solid white;
        }
        
        .sidebar-menu i {
            margin-right: 10px;
        }
        
        .main-content {
            padding: 20px;
        }
        
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            border: none;
        }
        
        .card-header {
            background-color: white;
            border-bottom: 1px solid #eee;
            font-weight: 600;
            padding: 15px 20px;
            border-radius: 10px 10px 0 0 !important;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .btn-primary:hover {
            background-color: #5649d1;
            border-color: #5649d1;
        }
        
        .table th {
            border-top: none;
            font-weight: 600;
            color: var(--dark-color);
        }
        
        .badge {
            padding: 6px 10px;
            font-weight: 500;
        }
        
        .action-btn {
            padding: 5px 10px;
            margin: 0 3px;
            border-radius: 5px;
        }
        
        .search-box {
            position: relative;
        }
        
        .search-box input {
            padding-left: 40px;
            border-radius: 20px;
        }
        
        .search-box i {
            position: absolute;
            left: 15px;
            top: 10px;
            color: #aaa;
        }
        
        .modal-header {
            border-bottom: none;
            padding-bottom: 0;
        }
        
        .modal-footer {
            border-top: none;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar">
                <div class="sidebar-header">
                    <h4><i class="bi bi-music-note-beamed"></i> Vibe Wave</h4>
                </div>
                <div class="sidebar-menu">
                    <a href="#" class="active"><i class="bi bi-speedometer2"></i> Dashboard</a>
                    <a href="#musicas"><i class="bi bi-music-note-list"></i> Músicas</a>
                    <a href="#artistas"><i class="bi bi-person-badge"></i> Artistas</a>
                    <a href="#"><i class="bi bi-collection-play"></i> Playlists</a>
                    <a href="#usuarios"><i class="bi bi-people"></i> Usuários</a>
                    <a href="#"><i class="bi bi-gear"></i> Configurações</a>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 ms-sm-auto main-content">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Dashboard</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary">Exportar</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary">Imprimir</button>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle"></i> Novo Item
                        </button>
                    </div>
                </div>
                
                <!-- Cards de Resumo -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Total de Músicas</h6>
                                        <h2 id="MostrarMusicas">{{musica}}</h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-music-note-beamed fs-1 text-primary"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Total de Artistas</h6>
                                        <h2 id="MostrarArtistas"></h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-people fs-1 text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted">Downloads</h6>
                                        <h2>-----</h2>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="bi bi-download fs-1 text-warning"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Seção de Músicas -->
                <div class="card mb-4" id="musicas">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-music-note-list me-2"></i> Músicas</h5>
                        <div>
                            <div class="search-box me-2 d-inline-block">
                                <i class="bi bi-search"></i>
                                <input type="text" class="form-control form-control-sm" placeholder="Pesquisar música...">
                            </div>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addMusicModal">
                                <i class="bi bi-plus"></i> Adicionar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Título</th>
                                        <th>Artista</th>
                                        <th>Duração</th>
                                        <th>Gênero</th>
                                        <th>Status</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each musica}}
                                    <tr>
                                        <td>{{_id}}</td>
                                        <td>{{titulo}}</td>
                                        <td>{{this.artista.nome}}</td>
                                        <td>{{duracao}}</td>
                                        <td>{{genero}}</td>
                                        <td><span class="badge bg-success">{{status}}</span></td>
                                        <td>
                                            <a href="/admin/music/img/{{_id}}"><button title="Adicionar Imagem" class="btn btn-sm btn-outline-primary action-btn"><i class="bi bi-image"></i></button></a>
                                           <a href="/admin/musica/edit/{{_id}}"><button class="btn btn-sm btn-outline-primary action-btn"><i class="bi bi-pencil"></i></button></a>
                                            <form action="admin/musica/delete/{{_id}}" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Excluir artista">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Próxima</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
                
                <!-- Seção de Artistas -->
                <div class="card mb-4" id="artistas">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i> Artistas</h5>
                        <div>
                            <div class="search-box me-2 d-inline-block">
                                <i class="bi bi-search"></i>
                                <input type="text" class="form-control form-control-sm" placeholder="Pesquisar artista...">
                            </div>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addArtistModal">
                                <i class="bi bi-plus"></i> Adicionar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nome</th>
                                        <th>Gênero</th>
                                        <th>Músicas</th>
                                        <th>País</th>
                                        <th>Status</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each artistas}}
                                    <tr> 
                                        <td>#{{_id}}</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="./uploads/artistas/{{foto}}" class="rounded-circle me-2" width="40" height="40">
                                                {{nome}}
                                            </div>
                                        </td>
                                        <td>{{genero_musical}}</td>
                                        <td>---</td>
                                        <td>{{pais}}</td>
                                        <td><span class="badge bg-success">{{status}}</span></td>
                                        <td>
                                            <a href="/admin/artista/edit/{{_id}}"><button class="btn btn-sm btn-outline-primary action-btn"><i class="bi bi-pencil"></i></button></a>
                                            <form action="admin/artista/delete/{{_id}}" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Excluir artista">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <p>NENHUM ARTISTA CADASTRADO</p>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Próxima</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>

                <!-- Seção de Usuarios -->
                <div class="card mb-4" id="usuarios">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i> Usuarios</h5>
                        <div>
                            <div class="search-box me-2 d-inline-block">
                                <i class="bi bi-search"></i>
                                <input type="text" class="form-control form-control-sm" placeholder="Pesquisar artista...">
                            </div>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addArtistModal">
                                <i class="bi bi-plus"></i> Adicionar
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nome</th>
                                        <th>Email</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each usuarios}}
                                    <tr> 
                                        <td>#{{this.id}}</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="./uploads/FotoUser/{{this.foto}}" class="rounded-circle me-2" width="40" height="40">
                                                {{this.name}}
                                            </div>
                                        </td>
                                        <td>{{this.email}}</td>
                                        <td>
                                            <a href=""><button class="btn btn-sm btn-outline-primary action-btn"><i class="bi bi-pencil"></i></button></a>
                                            <form action="" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Excluir artista">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <p>NENHUM ARTISTA CADASTRADO</p>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Próxima</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal Adicionar Música -->
    <div class="modal fade" id="addMusicModal" tabindex="-1" aria-labelledby="addMusicModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addMusicModalLabel"><i class="bi bi-music-note-beamed me-2"></i> Adicionar Nova Música</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" action="admin/musicas/nova" enctype="multipart/form-data">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="musicTitle" class="form-label">Título da Música</label>
                                <input name="titulomusica" type="text" class="form-control" id="musicTitle" placeholder="Digite o título da música" >
                            </div>
                            <div class="col-md-6">
                                <label for="musicArtist" class="form-label">Artista</label>
                                <select name="musicaartista" class="form-select" id="musicArtist" >
                                    <option value="" selected disabled>Selecione um artista</option>
                                    {{#each artistas}}
                                    <option value="{{_id}}">{{nome}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            
                            <div class="col-md-6">
                                <label for="musicGenre" class="form-label">Gênero</label>
                                <select name="musicagenero" class="form-select" id="musicGenre" >
                                    <option value="" selected disabled>Selecione um gênero</option>
                                    <option value="Pop">Pop</option>
                                    <option value="Rock">Rock</option>
                                    <option value="Rap">Rap</option>
                                    <option value="Hip Hop">Hip Hop</option>
                                    <option value="Eletrônica">Eletrônica</option>
                                    <option value="R&B">R&B</option>
                                    <option value="Jazz">Jazz</option>
                                    <option value="Clássica">Clássica</option>
                                    <option value="Country">Country</option>
                                    <option value="Reggae">Reggae</option>
                                    <option value="Sertanejo">Sertanejo</option>
                                    <option value="Funk">Funk</option>
                                    <option value="Outro">Outro</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="musicReleaseDate" class="form-label">Data de Lançamento</label>
                                <input name="musicadate" type="date" class="form-control" id="musicReleaseDate">
                            </div>
                            <div class="col-md-6">
                                <label for="musicStatus" class="form-label">Status</label>
                                <select name="musicastatus" class="form-select" id="musicStatus" >
                                    <option value="active" selected>Ativo</option>
                                    <option value="pending">Pendente</option>
                                    <option value="inactive">Inativo</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="musicFile" class="form-label">Arquivo de Música</label>
                            <input class="form-control" name="musicaaudio" type="file" id="musicFile" accept="audio/*" required>
                        </div>
                        <div class="mb-3">
                            <label for="musicLyrics" class="form-label">Letra da Música (Opcional)</label>
                            <textarea name="musicaletra" class="form-control" id="musicLyrics" rows="4" placeholder="Digite a letra da música..."></textarea>
                        </div>
                            <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Salvar Música</button>
                        </div>
                    </form>
                </div>
                
            </div>
        </div>
    </div>
    
    <!-- Modal Adicionar Artista -->
    <div class="modal fade" id="addArtistModal" tabindex="-1" aria-labelledby="addArtistModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addArtistModalLabel"><i class="bi bi-person-plus me-2"></i> Adicionar Novo Artista</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                <form method="post" action="admin/artista/novo" enctype="multipart/form-data">
                    <!-- Seção Básica -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="name" class="form-label">Nome do Artista*</label>
                            <input type="text" name="nome" class="form-control" id="name" placeholder="Digite o nome completo" required>
                        </div>
                        <div class="col-md-6">
                            <label for="country" class="form-label">País de Origem*</label>
                            <select name="country" class="form-select" id="country" required>
                                <option value="" selected disabled>Selecione um país</option>
                                <option value="Brasil">Brasil</option>
                                <option value="Estados Unidos">Estados Unidos</option>
                                <option value="Reino Unido">Reino Unido</option>
                                <option value="Canadá">Canadá</option>
                                <option value="Alemanha">Alemanha</option>
                                <option value="França">França</option>
                                <!-- Adicione mais países conforme necessário -->
                            </select>
                        </div>
                    </div>

                    <!-- Gênero e Status -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="mainGenre" class="form-label">Gênero Principal*</label>
                            <select name="mainGenre" class="form-select" id="mainGenre" required>
                                <option value="" selected disabled>Selecione um gênero</option>
                                <option value="Pop">Pop</option>
                                <option value="Rock">Rock</option>
                                <option value="Rap">Rap</option>
                                <option value="Hip Hop">Hip Hop</option>
                                <option value="Eletrônica">Eletrônica</option>
                                <option value="R&B">R&B</option>
                                <option value="Jazz">Jazz</option>
                                <option value="Clássica">Clássica</option>
                                <option value="Country">Country</option>
                                <option value="Reggae">Reggae</option>
                                <option value="Sertanejo">Sertanejo</option>
                                <option value="Funk">Funk</option>
                                <option value="Outro">Outro</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="status" class="form-label">Status*</label>
                            <select name="status" class="form-select" id="status" required>
                                <option value="Ativo" selected>Ativo</option>
                                <option value="Inativo">Inativo</option>
                                <option value="Pausa">Em Pausa</option>
                                <option value="Falecido">Falecido</option>
                            </select>
                        </div>
                    </div>

                    <!-- Biografia -->
                    <div class="mb-3">
                        <label for="biography" class="form-label">Biografia</label>
                        <textarea name="biography" class="form-control" id="biography" rows="4" placeholder="Descreva a carreira e importância do artista..." required></textarea>
                        <div class="form-text">Máximo de 5000 caracteres</div>
                    </div>

                    <!-- Foto e Website -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="photoUrl" class="form-label">Foto do Artista</label>
                            <input name="file" class="form-control" type="file" id="photoUrl" accept="image/*">
                            <div class="form-text">Formatos: JPG, PNG (Máx. 5MB)</div>
                        </div>
                        <div class="col-md-6">
                            <label for="website" class="form-label">Website</label>
                            <input name="website" type="url" class="form-control" id="website" placeholder="https://www.exemplo.com">
                        </div>
                    </div>

                    <!-- Data de Nascimento e Redes Sociais -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label for="birthDate" class="form-label">Data de Nascimento/Fundação</label>
                            <input name="birthDate" type="date" class="form-control" id="birthDate" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Rede Social Principal</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <select name="mainSocialMedia[platform]" class="form-select social-media-select" id="socialPlatform">
                                        <option value="Instagram">Instagram</option>
                                        <option value="Twitter">Twitter</option>
                                        <option value="Facebook">Facebook</option>
                                        <option value="YouTube">YouTube</option>
                                        <option value="TikTok">TikTok</option>
                                        <option value="Outro">Outro</option>
                                    </select>
                                </div>
                                <div class="col-8">
                                    <div class="input-group">
                                        <span class="input-group-text">@</span>
                                        <input name="mainSocialMedia[handle]" type="text" class="form-control" placeholder="usuário">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botões -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="reset" class="btn btn-secondary me-md-2">Limpar</button>
                        <button type="submit" class="btn btn-primary">Cadastrar Artista</button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/admin.js"></script>
</body>
