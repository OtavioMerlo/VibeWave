<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vibewave | Editar Artista</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="form-page">
        <div class="form-card">
            <h1><i class="fas fa-user-pen" style="color:#a78bfa"></i> Editar artista</h1>
            <p class="sub">Atualizando <strong>{{artista.nome}}</strong></p>

            <form method="post" action="/admin/artista/edit" enctype="multipart/form-data">
                <div class="form-grid">
                    <div class="field">
                        <label for="nome">Nome do artista *</label>
                        <input type="text" id="nome" name="nome" required value="{{artista.nome}}">
                    </div>
                    <div class="field">
                        <label for="pais">País de origem *</label>
                        <input type="text" id="pais" name="pais" required value="{{artista.pais}}">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label for="genero_musical">Gênero musical *</label>
                        <select id="genero_musical" name="genero_musical" required>
                            <option value="{{artista.genero_musical}}" selected>{{artista.genero_musical}}</option>
                            <option value="Pop">Pop</option>
                            <option value="Rock">Rock</option>
                            <option value="Rap">Rap</option>
                            <option value="Hip Hop">Hip Hop</option>
                            <option value="Eletrônica">Eletrônica</option>
                            <option value="R&B">R&B</option>
                            <option value="Jazz">Jazz</option>
                            <option value="Clássica">Clássica</option>
                            <option value="Country">Country</option>
                            <option value="Reggae">Reggae</option>
                            <option value="Sertanejo">Sertanejo</option>
                            <option value="Funk">Funk</option>
                            <option value="Outro">Outro</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="status">Status *</label>
                        <select id="status" name="status" required>
                            <option value="Ativo" {{#eq artista.status "Ativo"}}selected{{/eq}}>Ativo</option>
                            <option value="Inativo" {{#eq artista.status "Inativo"}}selected{{/eq}}>Inativo</option>
                            <option value="Pausa" {{#eq artista.status "Pausa"}}selected{{/eq}}>Em Pausa</option>
                            <option value="Falecido" {{#eq artista.status "Falecido"}}selected{{/eq}}>Falecido</option>
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label for="biografia">Biografia</label>
                    <textarea id="biografia" name="biografia">{{artista.biografia}}</textarea>
                </div>

                <div class="field">
                    <label>Foto do artista</label>
                    <div class="photo-row">
                        <img id="photoPreview" src="/uploads/artistas/{{artista.foto}}" class="photo-preview" alt="{{artista.nome}}">
                        <input type="file" id="photoUrl" name="foto" accept="image/*">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label for="website">Website</label>
                        <input type="url" id="website" name="website" value="{{artista.website}}" placeholder="https://www.exemplo.com">
                    </div>
                    <div class="field">
                        <label for="datanas">Data de nascimento</label>
                        <input type="date" id="datanas" name="datanas" value="{{artista.datanas}}">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label for="plataforma">Plataforma principal</label>
                        <select id="plataforma" name="plataforma">
                            <option value="{{artista.plataforma}}" selected>{{artista.plataforma}}</option>
                            <option value="Spotify">Spotify</option>
                            <option value="YouTube">YouTube</option>
                            <option value="Apple Music">Apple Music</option>
                            <option value="Deezer">Deezer</option>
                            <option value="SoundCloud">SoundCloud</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="handle">Handle / usuário</label>
                        <input type="text" id="handle" name="handle" value="{{artista.handle}}">
                    </div>
                </div>

                <input type="hidden" name="id" value="{{artista.id}}">

                <div class="form-actions">
                    <a href="/admin" class="btn btn-ghost"><i class="fas fa-times"></i> Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Salvar artista</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var input = document.getElementById('photoUrl');
        var preview = document.getElementById('photoPreview');
        input.addEventListener('change', function () {
            var file = this.files && this.files[0];
            if (file) preview.src = URL.createObjectURL(file);
        });
    </script>
</body>
</html>
