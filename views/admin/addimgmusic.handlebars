<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Musical | SonicFlow</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #7b2cbf;
            --primary-dark: #5a189a;
            --primary-light: #9d4edd;
            --secondary: #e0aaff;
            --text: #f8f9fa;
            --bg: #10002b;
            --card-bg: #1a0933;
            --transition: all 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(123, 44, 191, 0.15) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(157, 78, 221, 0.15) 0%, transparent 20%);
            animation: bgPulse 16s infinite alternate;
        }

        @keyframes bgPulse {
            0% { background-position: 10% 20%, 90% 80%; }
            50% { background-position: 20% 30%, 80% 70%; }
            100% { background-position: 5% 15%, 95% 85%; }
        }

        .form-container {
            width: 100%;
            max-width: 600px;
            background: var(--card-bg);
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transform: translateY(0);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .form-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to bottom right,
                transparent 45%,
                rgba(157, 78, 221, 0.1) 50%,
                transparent 55%
            );
            animation: shine 6s infinite;
            z-index: -1;
        }

        @keyframes shine {
            0% { transform: rotate(0deg) translate(-50%, -50%); }
            100% { transform: rotate(360deg) translate(-50%, -50%); }
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-weight: 600;
            font-size: 28px;
            color: var(--secondary);
            position: relative;
            display: inline-block;
            width: 100%;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border-radius: 3px;
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
        }

        label {
            display: block;
            margin-bottom: 12px;
            font-weight: 500;
            font-size: 16px;
            color: var(--secondary);
            transition: var(--transition);
        }

        .image-upload {
            border: 2px dashed rgba(224, 170, 255, 0.3);
            border-radius: 12px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            background: rgba(26, 9, 51, 0.5);
        }

        .image-upload:hover {
            border-color: var(--primary-light);
            background: rgba(123, 44, 191, 0.1);
            transform: translateY(-3px);
        }

        .image-upload.active {
            border-color: var(--primary);
            background: rgba(123, 44, 191, 0.2);
        }

        .image-upload i {
            font-size: 48px;
            color: var(--primary-light);
            margin-bottom: 15px;
            transition: var(--transition);
            display: block;
        }

        .image-upload:hover i {
            transform: scale(1.1);
            color: var(--secondary);
        }

        .image-upload p {
            margin: 0;
            color: rgba(248, 249, 250, 0.7);
            transition: var(--transition);
        }

        .image-upload:hover p {
            color: var(--text);
        }

        .image-upload p.small {
            font-size: 13px;
            margin-top: 8px;
            color: rgba(248, 249, 250, 0.5);
        }

        #image-preview {
            max-width: 100%;
            max-height: 200px;
            border-radius: 8px;
            display: none;
            margin: 15px auto 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            animation: fadeIn 0.6s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        input[type="file"] {
            display: none;
        }

        .btn-submit {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            padding: 16px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            width: 100%;
            transition: var(--transition);
            box-shadow: 0 4px 15px rgba(123, 44, 191, 0.3);
            position: relative;
            overflow: hidden;
            margin-top: 10px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(123, 44, 191, 0.4);
        }

        .btn-submit:active {
            transform: translateY(1px);
        }

        .btn-submit::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to bottom right,
                transparent 45%,
                rgba(255, 255, 255, 0.2) 50%,
                transparent 55%
            );
            animation: shine 3s infinite;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .btn-submit:hover::after {
            opacity: 1;
        }

        .progress-bar {
            width: 0;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            position: absolute;
            bottom: 0;
            left: 0;
            border-radius: 0 0 12px 12px;
            transition: width 0.4s ease;
        }

        .ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
            transform: scale(0);
            animation: ripple 0.6s linear;
            pointer-events: none;
        }

        @keyframes ripple {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        @media (max-width: 768px) {
            .form-container {
                padding: 30px 20px;
            }
            
            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="form-container">
        <h1>Upload de Música</h1>
        
        <form method="post"  action="/admin/musica/edit/{{id}}" id="music-form" enctype="multipart/form-data">
            <div class="form-group">
                <label for="music-image">Capa do Álbum</label>
                
                <div class="image-upload" id="upload-area">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <p>Arraste e solte sua imagem aqui</p>
                    <p class="small">ou clique para selecionar</p>
                    <p class="small">PNG, JPG (Max. 5MB)</p>
                    <img id="image-preview" alt="Pré-visualização da capa do álbum">
                    <div class="progress-bar" id="progress-bar"></div>
                </div>
                <input name="file" type="file" id="music-image" accept="image/*">
            </div>
            
            <button type="submit" class="btn-submit" id="submit-btn">
                <span class="btn-text">Enviar Música</span>
            </button>
        </form>
    </div>

    <script>
        const uploadArea = document.getElementById('upload-area');
        const fileInput = document.getElementById('music-image');
        const imagePreview = document.getElementById('image-preview');
        const submitBtn = document.getElementById('submit-btn');
        const progressBar = document.getElementById('progress-bar');
        const form = document.getElementById('music-form');

        // Efeito de ripple nos botões
        document.querySelectorAll('.btn-submit, .image-upload').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const ripple = document.createElement('span');
                ripple.classList.add('ripple');
                ripple.style.left = `${x}px`;
                ripple.style.top = `${y}px`;
                
                this.appendChild(ripple);
                
                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });
        });

        // Upload Area Interactions
        uploadArea.addEventListener('click', () => {
            fileInput.click();
            uploadArea.classList.add('active');
            setTimeout(() => uploadArea.classList.remove('active'), 1000);
        });

        // Drag and Drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = 'var(--primary-light)';
            uploadArea.style.backgroundColor = 'rgba(123, 44, 191, 0.2)';
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = 'rgba(224, 170, 255, 0.3)';
            uploadArea.style.backgroundColor = 'rgba(26, 9, 51, 0.5)';
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = 'var(--primary)';
            uploadArea.style.backgroundColor = 'rgba(123, 44, 191, 0.2)';
            
            if (e.dataTransfer.files.length) {
                fileInput.files = e.dataTransfer.files;
                previewImage(e.dataTransfer.files[0]);
                
                // Efeito visual ao soltar arquivo
                uploadArea.classList.add('active');
                setTimeout(() => uploadArea.classList.remove('active'), 1000);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length) {
                previewImage(fileInput.files[0]);
            }
        });

        function previewImage(file) {
            if (!file.type.match('image.*')) {
                alert('Por favor, selecione um arquivo de imagem válido.');
                return;
            }

            const reader = new FileReader();
            
            reader.onloadstart = () => {
                progressBar.style.width = '30%';
            };
            
            reader.onprogress = (e) => {
                if (e.lengthComputable) {
                    const percentLoaded = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = `${percentLoaded}%`;
                }
            };
            
            reader.onload = (e) => {
                progressBar.style.width = '100%';
                setTimeout(() => {
                    progressBar.style.width = '0';
                }, 500);
                
                imagePreview.src = e.target.result;
                imagePreview.style.display = 'block';
                
                // Esconde os textos quando a imagem é carregada
                uploadArea.querySelectorAll('p').forEach(p => p.style.display = 'none');
                uploadArea.querySelector('i').style.display = 'none';
                
                // Animação de entrada da imagem
                imagePreview.style.animation = 'fadeIn 0.6s ease-out';
            };
            
            reader.onerror = () => {
                progressBar.style.width = '0';
                alert('Ocorreu um erro ao carregar a imagem.');
            };
            
            reader.readAsDataURL(file);
        }

        // Simulação de upload
        
    </script>
</body>
</html>